# PitchLog 프론트엔드 환경변수 예시
# 실제 값은 .env.local에 작성하고 절대 커밋하지 마세요.

# 데이터 소스 전환
#   true  (기본) → Mock. 백엔드 없이 모든 화면이 뜬다
#   false        → 실 API. 아직 백엔드에 없는 화면은 "아직 백엔드에 없는 데이터입니다" 오류를 낸다
#                  (지금 있는 것: 대회 목록·상세 · 팀 목록·상세 · 경기 목록·상세 · 순위표)
VITE_USE_MOCK=true

# 백엔드 API 기본 URL. VITE_USE_MOCK=false 일 때만 쓰인다.
# 비우면 같은 출처로 요청한다 (Vite proxy 를 쓰는 경우)
VITE_API_BASE_URL=http://localhost:3000

# 로고 정적 파일 위치. 기본값은 이 앱이 서빙하는 /logos (frontend/public/logos)
# 나중에 R2·CDN 으로 옮기면 이 값만 바꾼다
VITE_LOGO_BASE_URL=/logos
