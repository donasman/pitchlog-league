#!/bin/sh
# PitchLog pre-commit — 조용히 망가지는 것을 커밋 전에 잡는다
# 활성화: git config core.hooksPath .githooks
set -e

fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

for f in $files; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.woff|*.woff2|*.ttf|*.tgz|*.zip) continue ;;
  esac

  # null byte — 텍스트 파일에 들어가면 도구가 조용히 깨진다
  # -a 가 없으면 grep 이 파일을 바이너리로 판정하고 매치를 보고하지 않는다 (2026-09-07 실제로 놓쳤다)
  if LC_ALL=C grep -qaP '\x00' "$f" 2>/dev/null; then
    echo "pre-commit: null byte — $f"; fail=1
  fi

  # 깨진 UTF-8 — 한국어 문서·i18n 에서 실제로 발생했다
  if ! iconv -f UTF-8 -t UTF-8 "$f" >/dev/null 2>&1; then
    echo "pre-commit: 깨진 UTF-8 — $f"; fail=1
  fi
done

# 커밋 금지 파일
for f in $files; do
  case "$f" in
    backend/.env|backend/.env.local|frontend/.env|frontend/.env.local|*.env.local)
      echo "pre-commit: 환경변수 파일은 커밋하지 않는다 — $f"; fail=1 ;;
  esac
done

# API 키가 코드에 박혀 있는지
if git diff --cached -U0 | grep -nE '^\+.*(x-apisports-key|API_FOOTBALL_KEY)\s*[:=]\s*["\x27][A-Za-z0-9]{20,}' ; then
  echo "pre-commit: API 키가 하드코딩됐다"; fail=1
fi

[ "$fail" -eq 0 ] || { echo "pre-commit 실패. 위 항목을 고친 뒤 다시 커밋한다."; exit 1; }
exit 0
