# /etc/pitchlog/backend.env — bootstrap.sh 가 이 파일을 템플릿으로 복사한다 (0600 · pitchlog:pitchlog)
# systemd EnvironmentFile 문법: 값에 따옴표 붙이지 않는다. 공백 없이 KEY=VALUE.
#
# 필수 항목을 채운 뒤 서비스를 재시작한다 (sudo systemctl restart pitchlog-backend):
#   sudoedit /etc/pitchlog/backend.env

# ── 필수 ──────────────────────────────────────────────────

# Supabase Session Pooler 형식. 로컬 backend/.env 의 DATABASE_URL 값을 그대로 복사한다.
# 직결 호스트(db.*.supabase.co) 는 IPv6 전용일 수 있어 EC2 기본 VPC 에서 실패할 수 있다.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Gemini API 키. 비우면 부팅은 성공하나 POST /api/assistant 는 503
GEMINI_API_KEY=

# API-Football 키. 서버가 조회만 하면 비워도 부팅 (수집 CLI 호출 시점에만 필요)
API_FOOTBALL_KEY=

# S3 백업 업로드 대상 (backup-to-s3.sh 가 읽음 · 하드코딩 금지 · 비면 스크립트 exit 1).
# EC2 인스턴스 IAM 역할이 s3:PutObject / s3:ListBucket / s3:GetObject 가능해야 한다.
BACKUP_S3_BUCKET=<BUCKET>

# ── 기본값 (필요 시만 변경) ──────────────────────────────

# 09-11 RPD 실측 — Flash 3.x 무료는 20/일, lite 는 500/일. 코드 기본값은 아직 gemini-3.5-flash (env.validation.ts:63)
# → 이 env 로 덮는다. 코드 기본값 이관은 별도 판.
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3000
NODE_ENV=production

# CORS — Vercel rewrite 로 same-origin 이라 비워둔다.
# 비우면 CORS 자체를 켜지 않는다 (app.setup.ts:23-34).
CORS_ORIGIN=

# 어시스턴트 디버그 헤더 (X-Gemini-Requests). 프로덕션 false 유지.
ASSISTANT_DEBUG_HEADERS=false

# ── 스케줄러 · 백필 워커 (4-b-1) ─────────────────────────
# 재시작이 곧 스위치 (sudo systemctl restart pitchlog-backend 로 반영).
# 마스터 스위치 — false 면 어떤 잡도 등록되지 않는다.
SCHEDULER_ENABLED=false
# 백필 워커 개별 스위치 (SCHEDULER_ENABLED=true 여야 효과 있음).
BACKFILL_WORKER_ENABLED=false
# 백필 워커 cron (5 필드 · 기본 매시 5분). 잘못된 값은 부팅에서 CronJob 생성자가 잡음.
BACKFILL_WORKER_CRON=5 * * * *
# 백필 워커 1회 실행당 경기 수 상한 (4콜/경기 · 200 = 800콜 · DAILY_CAP 5,700 안).
BACKFILL_WORKER_LIMIT=200
# 백필 워커가 순회할 시즌 목록 (쉼표 구분 · 앞에서부터 처리 · 빈 값 = 현재 시즌만).
# 백필-2 켜기: BACKFILL_WORKER_SEASONS=2025,2024,2023,2022
BACKFILL_WORKER_SEASONS=
# 일일 자율 상한 (기본 5700 · 하드 한도 7500). /status 카운터가 약 2분 지연돼 실제 사용량은 상한보다 최대 ~320콜 많을 수 있다. 백필-2 기간 운영값 6800.
BACKFILL_DAILY_CAP=

# ── 미사용 (현 구성) ────────────────────────────────────

# 다중 인스턴스 도입 시에만
# REDIS_URL=

# 로고는 프론트 정적 폴더에 커밋돼 있음 · 서버 배포엔 불필요
# LOGO_OUTPUT_DIR=

# 백업 (backup.mjs · pitchlog-backup.timer)
# BACKUP_DIR 은 pitchlog-backup.service 의 Environment= 로 /var/backups/pitchlog 고정.
# 이 파일에 두면 systemd 유닛 값을 덮으므로 두지 않는다 (수동 backup.mjs 는 backend/.env 를 씀).
# BACKUP_PG_IMAGE · BACKUP_SCHEMA 는 backup.mjs 기본값(postgres:17 · public) 그대로.
# BACKUP_PG_IMAGE=postgres:17
# BACKUP_SCHEMA=public

# ── L4 라이브 폴러 (관측 모드) ─────────────────────────────────
# 마스터 스위치 — false 면 잡 미등록. SCHEDULER_ENABLED=true 와 API_FOOTBALL_KEY 필요.
LIVE_POLLER_ENABLED=false
# 정상 주기 (초). 5~300.
LIVE_POLLER_PERIOD_SEC=15
# used ≥ SLOW_AT 이면 이 주기로 강등. 10~600 · PERIOD_SEC 보다 커야 한다.
LIVE_POLLER_SLOW_PERIOD_SEC=30
# 강등 임계 (오늘 사용량 · /status requests.current). 1~7500 · STOP_AT 보다 작아야 한다.
LIVE_POLLER_SLOW_AT=6000
# 정지 임계. 이 값 이상이면 UTC 자정까지 정지. 1~7500 · SLOW_AT 보다 크고 7500 이하.
LIVE_POLLER_STOP_AT=7000
# A매치 probe (DB 에 없는 경기 · 쉼표 구분 apiFixtureId · 개수 ≤ 20 · 중복 금지 · 빈값 OK).
# 예: 1628999,1629003,1629005 (KOR 9/28 URU · 10/2 VEN · 10/6 UZB)
LIVE_POLLER_PROBE_FIXTURE_IDS=
