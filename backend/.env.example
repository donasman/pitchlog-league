# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다 (pre-commit 훅이 막는다)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
API_FOOTBALL_KEY=
PORT=3000
NODE_ENV=development

# 프론트 출처 허용 목록 (쉼표 구분). 비우면 CORS 를 켜지 않는다
# Vite dev 서버 기본값: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# `npm run ingest -- logos` 가 로고를 저장할 위치 (backend/ 기준 상대 경로 허용)
# 기본값이 프론트 정적 폴더라 Cloudflare Pages 가 그대로 서빙한다
LOGO_OUTPUT_DIR=../frontend/public/logos

# `npm run backup` 이 덤프를 쓸 위치. 비우면 홈 디렉터리 아래 PitchLogBackups
# 저장소 안을 가리키지 않는다 — 덤프는 커밋하지 않는다
BACKUP_DIR=

# pg_dump 가 PATH 에 없을 때 쓰는 Docker 이미지. 서버 메이저 버전 이상이어야 한다
BACKUP_PG_IMAGE=postgres:17

# 백업 대상 스키마. 비우면 public — Supabase 내부 스키마는 받지 않는다
BACKUP_SCHEMA=public

# Gemini API 키. 비우면 부팅은 되지만 POST /api/assistant 는 503 을 낸다 (실 키 커밋 금지)
GEMINI_API_KEY=
# Gemini 모델 ID. 기본값이 코드에도 박혀 있다
GEMINI_MODEL=gemini-3.5-flash
